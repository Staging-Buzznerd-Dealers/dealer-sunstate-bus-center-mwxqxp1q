                  "props": {
                    "heading": "What Fleet Owners Say",
                    "items": [
                      {
                        "quote": "They kept three of our trucks down for less than 48 hours combined all year. That's the difference a good service team makes.",
                        "name": "Marcus Webb",
                        "role": "Fleet Manager, Webb Logistics"
                      },
                      {
                        "quote": "Financing was straightforward and the team walked us through every option for our first Class 8 purchase.",
                        "name": "Dana Ortiz",
                        "role": "Owner-Operator"
                      },
                      {
                        "quote": "Parts counter always has what we need in stock, or it ships next day. Huge for uptime.",
                        "name": "Ray Callahan",
                        "role": "Operations Lead, Callahan Freight"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
