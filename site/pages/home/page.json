{
  "version": 2,
  "nodes": [
    {
      "id": "hero",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "ink",
        "paddingY": 9,
        "minHeight": "half",
        "align": "center",
        "anchor": "top"
      },
      "styles": {
        "base": {
          "position": "relative",
          "overflow": "hidden",
          "paddingTop": 140,
          "paddingBottom": 110,
          "minHeight": 600,
          "backgroundImage": "/img/hero-bus.jpg",
          "backgroundSize": "cover",
          "backgroundPosition": "center"
        }
      },
      "children": [
        {
          "id": "hero-scrim",
          "type": "spacer",
          "props": {
            "size": 1
          },
          "styles": {
            "base": {
              "position": "absolute",
              "inset": 0,
              "background": "#1A1714@55%"
            }
          }
        },
        {
          "id": "hero-row",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "center",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "hero-copy",
              "type": "column",
              "props": {
                "span": 8,
                "align": "center"
              },
              "children": [
                {
                  "id": "hero-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "New & Used School Buses",
                    "text": "Florida's Premier IC Bus Dealer",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "hero-lede",
                  "type": "text",
                  "props": {
                    "text": "Sun State Bus Centers is the exclusive IC Bus sales, parts, and service dealer for the state of Florida. IC Bus school buses come with a range of power options to fit your fleet."
                  }
                },
                {
                  "id": "hero-search",
                  "type": "widget",
                  "props": {
                    "widget": "inventory-search",
                    "config": {
                      "placeholder": "Search by stock #, model, or VIN"
                    }
                  }
                }
              ]
            }
          ],
          "styles": {
            "base": {
              "position": "relative",
              "zIndex": 1
            }
          }
        }
      ]
    },
    {
      "id": "quick-links",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 6
      },
      "children": [
        {
          "id": "ql-row",
          "type": "row",
          "props": {},
          "children": [
            {
              "id": "ql-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "hero-tiles",
                  "type": "iconGrid",
                  "props": {
                    "heading": "",
                    "items": [
                      {
                        "label": "New Buses",
                        "desc": "Browse new IC Bus inventory",
                        "url": "/store/inventory?condition=new"
                      },
                      {
                        "label": "Used Buses",
                        "desc": "Certified pre-owned buses",
                        "url": "/store/inventory?condition=used"
                      },
                      {
                        "label": "Schedule Service",
                        "desc": "Certified maintenance & repair",
                        "url": "/#service"
                      },
                      {
                        "label": "Order Parts",
                        "desc": "OEM parts, in stock",
                        "url": "/#parts"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "inventory",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7,
        "anchor": "inventory"
      },
      "children": [
        {
          "id": "inventory-row",
          "type": "row",
          "props": {},
          "children": [
            {
              "id": "inventory-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "inventory-widget",
                  "type": "widget",
                  "props": {
                    "widget": "inventory-carousel",
                    "config": {
                      "heading": "Featured Listings",
                      "limit": 4
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "about",
      "type": "statBand",
      "props": {
        "heading": "What We Offer",
        "body": "Why Sun State: the people and capacity behind every bus we sell and service.",
        "ctas": [
          {
            "ctaId": "about-us"
          }
        ],
        "stats": [
          {
            "value": "180+",
            "label": "Service Technicians"
          },
          {
            "value": "250+",
            "label": "Service Bays"
          },
          {
            "value": "50",
            "label": "Parts Delivery Vehicles"
          },
          {
            "value": "12+",
            "label": "Certified FDOE Bus Safety Inspectors"
          },
          {
            "value": "AC",
            "label": "Factory Trained AC Technicians"
          }
        ]
      }
    },
    {
      "id": "service-parts",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7
      },
      "children": [
        {
          "id": "sp-row",
          "type": "row",
          "props": {
            "gap": 6,
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "sp-service",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "sp-service-img",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/img/service-bus.jpg",
                      "alt": "IC Bus school bus with its stop arm extended"
                    }
                  }
                },
                {
                  "id": "sp-service-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Service Center",
                    "text": "Certified Maintenance & Repair",
                    "headingLevel": 2,
                    "anchor": "service"
                  }
                },
                {
                  "id": "sp-service-t",
                  "type": "text",
                  "props": {
                    "text": "Factory-trained technicians, genuine parts, and same-week appointments to keep your buses on the road longer."
                  }
                },
                {
                  "id": "sp-service-b",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "schedule-service"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "sp-parts",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "sp-parts-img",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/img/parts-bus.jpg",
                      "alt": "Fleet of school buses parked in a row"
                    }
                  }
                },
                {
                  "id": "sp-parts-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Parts Department",
                    "text": "OEM Parts, In Stock",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "sp-parts-t",
                  "type": "text",
                  "props": {
                    "text": "Order online or call our parts desk. Most in-stock orders ship same day."
                  }
                },
                {
                  "id": "sp-parts-b",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "order-parts"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "financing-banner",
