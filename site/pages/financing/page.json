              "children": [
                {
                  "id": "warranty-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Warranty Information",
                    "text": "Sun State Bus Centers Warranty Information",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "warranty-t",
                  "type": "text",
                  "props": {
                    "text": "Sun State Bus Centers has teamed up with the industry leaders for bus warranty protection plans, Bus Master Warranty. This partnership allows us to extend your manufacturer's warranty for new buses and protect used buses too. Some of the more sought after benefits of a bus protection plan include:"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "benefits",
      "type": "sharedSection",
      "props": {
        "sectionId": "benefit-grid",
        "values": {
          "heading": "",
          "items": [
            {
              "num": "01",
              "title": "Protection From The Unexpected",
              "text": "Repair costs can wreak havoc on a bus owner’s bank account. We offer “plan ahead” protection to prevent unforeseen financial despair that is inherent with breakdowns."
            },
            {
              "num": "02",
              "title": "New Buses Qualify",
              "text": "New bus plans protect any bus with at least 6 months of the original manufacturer’s warranty remaining on them for an ADDITIONAL 3 to 5 years."
            },
            {
              "num": "03",
              "title": "Most Used Buses Qualify",
              "text": "If your bus is less than 8 years old then it qualifies for 1 to 3 years of warranty coverage."
            },
            {
              "num": "04",
              "title": "Long-Term Protection",
              "text": "Customers are keeping their units on the road longer these days, which is why we offer industry leading, long-term protection plans for new and used commercial and school buses."
            },
            {
              "num": "05",
              "title": "Superior Customer Service Through-and-Through",
              "text": "World-class, white glove customer service throughout the entire process. Every time you call you get a knowledgeable representative on the phone to help answer any questions you might have."
            },
            {
              "num": "06",
              "title": "Future Proof Your Finances",
              "text": "The price to protect yourself today for 10 years hedges against inflation and saves you money in the long run. Pay today’s rates for the life of your contract on all covered repairs."
            },
            {
              "num": "07",
              "title": "Extensive Coverage",
              "text": "We offer the most extensive warranty coverage on the market, with more covered parts, more features, higher limits-of-liability, and peace of mind standard with every plan."
            },
            {
              "num": "08",
              "title": "Even More Benefits",
              "text": "Every bus protection plan comes standard with towing and roadside assistance. All of our plans are transferable, giving the added benefit of increased resale value should you decide to sell your bus."
            }
          ]
        }
      }
    },
