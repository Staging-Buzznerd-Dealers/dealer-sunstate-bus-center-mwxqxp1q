    {
      "id": "warranty",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 4
      },
      "children": [
        {
          "id": "warranty-row",
          "type": "row",
          "props": {},
          "children": [
            {
              "id": "warranty-col",
              "type": "column",
