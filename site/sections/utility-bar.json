{
  "version": 2,
  "id": "utility-bar",
  "name": "Utility bar",
  "css": "[data-bz-node=\"ub\"] .bz-block--image .bz-container{padding:0}\n[data-bz-node=\"ub\"] .bz-block--image .bz-figure{margin:0}\n[data-bz-node=\"ub\"] .bz-block--image img{width:16px;height:16px;border-radius:0}\n[data-bz-node=\"ub-social-col\"]{display:flex;gap:var(--space-3);align-items:center;justify-content:flex-end}\n[data-bz-node=\"ub-right\"]{display:flex;gap:var(--space-5);align-items:center;justify-content:flex-end;flex-wrap:wrap}\n[data-bz-node=\"ub\"] p{margin:0;font-size:var(--text-small)}",
  "props": [
    {
      "key": "phone",
      "type": "text",
      "label": "Phone number",
      "default": "800-741-7566"
    },
    {
      "key": "address",
      "type": "text",
      "label": "Address line",
      "default": "6020 Adamo Drive, Tampa, FL 33619"
    },
    {
      "key": "social",
      "type": "list",
      "label": "Social links",
      "fields": [
        {
          "key": "image",
          "type": "image",
          "label": "Icon"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Links to"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "ub",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "ink",
        "paddingY": 2
      },
      "children": [
        {
          "id": "ub-row",
          "type": "row",
          "props": {
            "gap": 4,
            "align": "center",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "ub-left",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "ub-phone",
                  "type": "text",
                  "props": {
                    "text": "{{phone}} · {{address}}",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "ub-right",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "ub-menu",
                  "type": "menu",
                  "props": {
                    "menuId": "utility",
                    "layout": "horizontal",
                    "align": "end",
                    "depth": 1
                  }
                },
                {
                  "id": "ub-social",
                  "type": "row",
                  "props": {},
                  "children": [
                    {
                      "id": "ub-social-col",
                      "type": "column",
                      "props": {
                        "span": 12
                      },
                      "children": [
                        {
                          "id": "ub-social-img",
                          "type": "image",
                          "props": {
                            "image": "{{image}}",
                            "url": "{{url}}",
                            "width": "prose",
                            "repeat": "social"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
