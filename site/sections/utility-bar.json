{
  "version": 2,
  "id": "utility-bar",
  "name": "Utility bar",
  "css": "[data-bz-node=\"ub\"]{font-size:13px}\n[data-bz-node=\"ub\"] .bz-block{padding-block:0}\n[data-bz-node=\"ub\"] .bz-container{max-width:var(--container)}\n[data-bz-node=\"ub\"] p{margin:0;font-size:13px;line-height:1.4;color:#B8B0A2}\n[data-bz-node=\"ub\"] p strong{color:#F2EEE6;font-weight:700;margin-right:var(--space-2)}\n[data-bz-node=\"ub-right\"]{display:flex;align-items:center;justify-content:flex-end;gap:var(--space-5);flex-wrap:wrap}\n[data-bz-node=\"ub-right\"] .bz-menu{flex:none}\n[data-bz-node=\"ub-right\"] .bz-navitem > a{color:#D8D2C4;font:500 13px/1.4 var(--font-body);padding:0;text-transform:none;letter-spacing:0}\n[data-bz-node=\"ub-right\"] .bz-navitem > a:hover{color:#fff}\n[data-bz-node=\"ub-right\"] .bz-block--image{flex:none;width:16px}\n[data-bz-node=\"ub-right\"] .bz-block--image .bz-container{padding:0}\n[data-bz-node=\"ub-right\"] .bz-figure{margin:0}\n[data-bz-node=\"ub-right\"] .bz-block--image img{width:16px;height:16px;border-radius:0}\n[data-bz-node=\"ub-right\"] .bz-block--image:first-of-type{margin-left:var(--space-3);padding-left:var(--space-5);border-left:1px solid rgba(255,255,255,.16);box-sizing:content-box}\n@media (max-width:1100px){[data-bz-node=\"ub-right\"]{justify-content:flex-start}}",
  "props": [
    {
      "key": "phone",
      "type": "text",
      "label": "Phone number",
      "default": "800-741-7566"
    },
    {
      "key": "address",
      "type": "text",
      "label": "Address line",
      "default": "6020 Adamo Drive, Tampa, FL 33619"
    },
    {
      "key": "social",
      "type": "list",
      "label": "Social links",
      "fields": [
        {
          "key": "image",
          "type": "image",
          "label": "Icon"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Links to"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "ub",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "ink",
        "paddingY": 3
      },
      "children": [
        {
          "id": "ub-row",
          "type": "row",
          "props": {
            "gap": 4,
            "align": "center",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "ub-left",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "ub-phone",
                  "type": "text",
                  "props": {
                    "text": "<strong>☎ {{phone}}</strong> {{address}}",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "ub-right",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "ub-menu",
                  "type": "menu",
                  "props": {
                    "menuId": "utility",
                    "layout": "horizontal",
                    "align": "end",
                    "depth": 1
                  }
                },
                {
                  "id": "ub-social-img",
                  "type": "image",
                  "props": {
                    "image": "{{image}}",
                    "url": "{{url}}",
                    "width": "prose",
                    "repeat": "social"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
